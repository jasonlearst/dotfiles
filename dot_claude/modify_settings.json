#!/bin/sh
# Adds the allow rules the /file-issue and /task skills need to settings.json, so auto mode's
# classifier doesn't block their issue and PR writes. The rest of the file stays machine-local.
input="$(cat)"
[ -n "$input" ] || input='{}'
printf '%s\n' "$input" | jq '.permissions.allow = (((.permissions.allow // []) + [
  "Bash(gh pr create *)",
  "Bash(gh issue create *)",
  "Bash(tea pulls create --login claude *)",
  "Bash(tea issues create --login claude *)",
  "Bash(tea api --login claude *)"
]) | reduce .[] as $rule ([]; if index([$rule]) then . else . + [$rule] end))'
