#!/bin/sh
# Adds the allow rules the /file-issue and /task skills need to settings.json, so auto mode's
# classifier doesn't block their issue and PR writes. Where ~/.agent-identity exists, also points
# CLAUDE_ENV_FILE at it, so every Claude Code session runs as the agent, and makes Claude always
# ask before acting as the owner: as-owner, or reaching the 1Password SSH agent or op directly.
# The rest stays machine-local.
input="$(cat)"
[ -n "$input" ] || input='{}'
activate="$HOME/.agent-identity/activate"
[ -f "$activate" ] || activate=""
printf '%s\n' "$input" | jq --arg activate "$activate" '
def add_unique($rules): ((. // []) + $rules) | reduce .[] as $rule ([]; if index([$rule]) then . else . + [$rule] end);
# The first version allowed every tea api call, deletes included; take that rule back out.
.permissions.allow |= ((. // []) - ["Bash(tea api --login claude *)"] | add_unique([
  "Bash(gh pr create *)",
  "Bash(gh issue create *)",
  "Bash(tea pulls create --login claude *)",
  "Bash(tea issues create --login claude *)",
  "Bash(tea api --login claude -X POST /repos/*/issues/*/comments -d @-)",
  "Bash(tea api --login claude -X PATCH /repos/*/pulls/* *)"
]))
| if $activate != "" then
    .env.CLAUDE_ENV_FILE = $activate
    | .permissions.ask |= add_unique([
        "Bash(as-owner *)",
        "Bash(SSH_AUTH_SOCK=*)",
        "Bash(/usr/bin/ssh *)",
        "Bash(/usr/local/bin/op *)"
      ])
  else . end'
