[user]
	name = {{ .user }}
	email = {{ .email }}
{{ includeTemplate "gitconfig-common" . }}
{{- if .isWSL }}
[core]
	sshCommand = ssh.exe
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
[diff]
	tool = bc
[merge]
	tool = bc
[mergetool "bc"]
	trustExitCode = true
{{- end }}
{{- if .isWSL }}
[diff]
	tool = bc
[merge]
	tool = bc
[mergetool "bc"]
	trustExitCode = true
	cmd = '/mnt/c/Program Files/Beyond Compare 4/BComp.exe' \"$(wslpath -aw $LOCAL)\" \"$(wslpath -aw $REMOTE)\" \"$(wslpath -aw $BASE)\" \"$(wslpath -aw $MERGED)\"
[difftool "bc"]
	cmd = '/mnt/c/Program Files/Beyond Compare 4/BComp.exe' \"$(wslpath -aw $LOCAL)\" \"$(wslpath -aw $REMOTE)\"
{{- end }}
[alias]
    d = difftool
[difftool]
	prompt = false
{{- if lookPath "gh" }}
[credential "https://github.com"]
	helper = 
	helper = !{{ lookPath "gh" }} auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !{{ lookPath "gh" }} auth git-credential
{{ end }}