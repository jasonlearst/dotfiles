# Agent identity git config (GIT_CONFIG_GLOBAL). Replaces ~/.gitconfig in agent
# sessions; the system config (osxkeychain) is skipped. activate also forces the
# identity, helpers and signing at command scope so a repo can't override them.
[user]
	name = {{ .agentName }}
	email = {{ .agentEmail }}
{{ includeTemplate "gitconfig-common" . }}
[core]
	sshCommand = /usr/bin/ssh -F '{{ .chezmoi.homeDir }}/.agent-identity/ssh/config' -i '{{ .chezmoi.homeDir }}/.agent-identity/ssh/id_ed25519_agent_{{ .chezmoi.hostname }}' -o IdentitiesOnly=yes -o IdentityAgent=none
[credential]
	helper = 
[commit]
	gpgSign = false
[tag]
	gpgSign = false
[credential "https://github.com"]
	helper = 
	helper = !{{ .chezmoi.homeDir }}/.agent-identity/bin/agent-github-app git-credential
	useHttpPath = true
[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/

[agent]
	# Who commits: agent (jasonlearst-agent) or owner (you). A repo overrides it
	# with `git config --local agent.commitAs owner|agent`. See shims/git.
	commitAs = owner
