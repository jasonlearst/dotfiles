# Agent identity git config (GIT_CONFIG_GLOBAL). Replaces ~/.gitconfig in agent
# sessions; the system config (osxkeychain) is skipped. activate also forces the
# identity, helpers and signing at command scope so a repo can't override them.
[user]
	name = jasonlearst-agent
	email = ***REMOVED***
[core]
	sshCommand = /usr/bin/ssh -F '{{ .chezmoi.homeDir }}/.agent-identity/ssh/config' -i '{{ .chezmoi.homeDir }}/.agent-identity/ssh/id_ed25519_agent_{{ .chezmoi.hostname }}' -o IdentitiesOnly=yes -o IdentityAgent=none
	excludesFile = {{ .chezmoi.homeDir }}/.gitignore_global
	autocrlf = input
[init]
	defaultBranch = main
[credential]
	helper = 
[commit]
	gpgSign = false
[tag]
	gpgSign = false
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[alias]
	graph = log --graph --color --pretty=format:%C(yellow)%H%C(green)%d%C(reset)%n%x20%cd%n%x20%cn%x20(%ce)%n%x20%s%n
	stat = status -sb
	last = log -1 --stat
	unstage = reset HEAD --
	cached = diff --cached
	merged = "!f() {         target=\"${1:-main}\";         git for-each-ref --format='%(refname:short)' refs/heads/ | while read -r b; do             [ \"$b\" = \"$target\" ] && continue;             if git worktree list --porcelain | grep -qx \"branch refs/heads/$b\"; then                 git merge-base --is-ancestor \"$b\" \"$target\" 2>/dev/null && printf '%s\\t%s\\n' \"$b\" 'merged (in use by a worktree)';                 continue;             fi;             if git merge-base --is-ancestor \"$b\" \"$target\" 2>/dev/null; then                 printf '%s\\t%s\\n' \"$b\" 'merged';             elif [ -z \"$(git cherry \"$target\" \"$b\" 2>/dev/null | grep '^+')\" ]; then                 printf '%s\\t%s\\n' \"$b\" 'rebased/squashed onto target';             fi;         done; }; f"
	sweep = "!f() {         target=\"${1:-main}\";         git merged \"$target\" | grep -v 'worktree' | while IFS=\"$(printf '\\t')\" read -r b why; do             case \"$why\" in                 merged) git branch -d \"$b\" ;;                 *) git branch -D \"$b\" ;;             esac;         done; }; f"
[credential "https://github.com"]
	helper = 
	helper = !{{ .chezmoi.homeDir }}/.agent-identity/bin/agent-github-app git-credential
	useHttpPath = true
[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/

[agent]
	# Who commits: agent (jasonlearst-agent) or owner (you). A repo overrides it
	# with `git config --local agent.commitAs owner|agent`. See shims/git.
	commitAs = agent
