#!/bin/bash
# git with the commit identity picked per repo by `agent.commitAs` (the repo's
# config, else git/config here):
#   owner  you, with the name and email your own git uses there: the repo's
#          user.name/user.email, else ~/.gitconfig. Work you direct is yours;
#          Claude stays a co-author through the commit trailer.
#   agent  jasonlearst-agent, with the GitHub App bot's no-reply address when a
#          remote is on GitHub (so GitHub links the commit to the bot) and the
#          agent's own address elsewhere (so Gitea never sees a github.com one).
# The identity is forced either way, so a repo's other settings can't switch it.
# Only the commit identity changes: pushes and API calls stay the agent's.

AI="${AGENT_IDENTITY_DIR:-$HOME/.agent-identity}"

real=""
IFS=: read -r -a dirs <<< "$PATH"
for d in "${dirs[@]}"; do
  [ "$d" = "$AI/shims" ] && continue
  if [ -x "$d/git" ]; then real="$d/git"; break; fi
done
[ -n "$real" ] || { echo "git: no git on PATH besides $AI/shims" >&2; exit 127; }

# The global options that say which repo this is: -C, --git-dir, --work-tree.
loc=()
args=("$@")
i=0
while [ $i -lt ${#args[@]} ]; do
  case ${args[$i]} in
    -C|--git-dir|--work-tree) loc+=("${args[$i]}" "${args[$((i + 1))]}"); i=$((i + 2)) ;;
    --git-dir=*|--work-tree=*) loc+=("${args[$i]}"); i=$((i + 1)) ;;
    -c|--namespace|--config-env) i=$((i + 2)) ;;
    -*) i=$((i + 1)) ;;
    *) break ;;
  esac
done

# Only commands that write commits or tags, or report the identity, need it.
case ${args[$i]:-} in
  commit|merge|pull|rebase|cherry-pick|revert|am|tag|stash|notes|commit-tree|replace|filter-branch|subtree|var|config) ;;
  *) exec "$real" "$@" ;;
esac

force() {  # [name] email: set the commit identity at every level git reads
  local name=$1 email=$2 k=0 key
  [ -n "$name" ] && export GIT_AUTHOR_NAME="$name" GIT_COMMITTER_NAME="$name"
  export GIT_AUTHOR_EMAIL="$email" GIT_COMMITTER_EMAIL="$email"
  while [ $k -lt "${GIT_CONFIG_COUNT:-0}" ]; do
    key="GIT_CONFIG_KEY_$k"
    case ${!key} in
      user.name) [ -n "$name" ] && export "GIT_CONFIG_VALUE_$k=$name" ;;
      user.email) export "GIT_CONFIG_VALUE_$k=$email" ;;
    esac
    k=$((k + 1))
  done
}

conf=$("$real" "${loc[@]}" config --get-regexp '^(agent\.commitas|remote\..*\.url)$' 2>/dev/null)
mode=$(printf '%s\n' "$conf" | awk '$1 == "agent.commitas" { m = $2 } END { print m }')

if [ "$mode" = owner ]; then
  name=$("$real" "${loc[@]}" config --local --get user.name 2>/dev/null || "$real" config --file "$HOME/.gitconfig" --get user.name 2>/dev/null)
  email=$("$real" "${loc[@]}" config --local --get user.email 2>/dev/null || "$real" config --file "$HOME/.gitconfig" --get user.email 2>/dev/null)
  if [ -n "$name" ] && [ -n "$email" ]; then
    force "$name" "$email"
  else
    echo "git: agent.commitAs is owner here, but no user.name/user.email in this repo or ~/.gitconfig; committing as the agent" >&2
  fi
else
  case $conf in
    *github.com*)
      email=$(sed -n "s/^GITHUB_APP_BOT_EMAIL='\(.*\)'\$/\1/p" "$AI/github-app/app.env" 2>/dev/null)
      [ -n "$email" ] && force "" "$email"
      ;;
  esac
fi

exec "$real" "$@"
