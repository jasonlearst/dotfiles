{{- /* Renders only where Homebrew is installed; elsewhere it's empty and chezmoi skips it. */ -}}
{{- $prefix := includeTemplate "homebrew-prefix" . | trim -}}
{{- if $prefix -}}
#!/bin/bash
#
# Install Brewfile packages on macOS. --no-upgrade means this only
# installs missing items; already-installed packages stay at their
# current version. Run `brew upgrade` manually when you want updates.
#
# chezmoi doesn't install Homebrew itself. This only renders on Macs that
# have it, so installing Homebrew later makes the next `chezmoi apply` run it.
#
# dot_Brewfile hash: {{ include "dot_Brewfile" | sha256sum }}

set -eufo pipefail

{{ $prefix }}/bin/brew bundle install --no-upgrade --file ~/.Brewfile
{{- end }}
