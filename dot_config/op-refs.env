# 1Password references (op://), not secrets: `op` resolves them, after your
# approval, only when something runs it. Sourced by fish and by agent shells
# (~/.agent-identity/activate), so both see the same references. Plain
# `export NAME="value"` lines, so fish, zsh and bash all read this file.

# sops 3.11+ runs this whenever it needs the age key; infra's with-secrets.sh
# also reads the reference out of it.
export SOPS_AGE_KEY_CMD="op read 'op://Personal/Infra - SOPS age Key/credential'"
