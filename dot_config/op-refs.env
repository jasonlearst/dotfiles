# 1Password references (op://), not secrets: `op` resolves them, after your
# approval, only when something runs it. Sourced by fish and by agent shells
# (~/.agent-identity/activate), so both see the same references. Only plain
# `command -v op … && export NAME="value"` lines, which fish, zsh and bash all
# read. The guard keeps them off machines without op, where sops should use
# its key file instead of failing to run op.

# sops 3.11+ runs this whenever it needs the age key; infra's with-secrets.sh
# also reads the reference out of it.
command -v op >/dev/null 2>&1 && export SOPS_AGE_KEY_CMD="op read 'op://Personal/Infra - SOPS age Key/credential'"

# Leave a success status, so sourcing this never trips a shell running set -e.
true
